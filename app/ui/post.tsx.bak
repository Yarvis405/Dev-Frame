"use client"

//add data later
import { useEffect, useState } from 'react'
import { surfer } from '../lib/utils.ts'
import PostLoading from './loading/post.tsx'
import Image from 'next/image'

interface postArgs {
    index: number,
    length: number,
    setLength: React.Dispatch<React.SetStateAction<number>>
}

const followStyle = `p-1 bg-purple-300 active:bg-purple-400 active:shadow-sm active:shadow-purple-400 active:scale-107 rounded-md text-white font-medium transition-all`

const Post = ({index, length, setLength }: postArgs) => {

    const [ item, setItem ] = useState<null | Awaited<ReturnType<typeof surfer>>>(null)
    const [ error, setError ] = useState<string | null>(null)

    const api = {
        url: 'https://api.github.com',
        endpoint: '/search/repositories',
        query: '?q=owner:yarvis405',
    }

    useEffect(() => {
        let alive = true
        setError(null)
        setItem(null)

        surfer({
            api: api.url,
            endpoint: api.endpoint,
            query: api.query,
        }).then((r) => {
            if(alive) setItem(r.items);
            if(alive) setLength(r.items.length - 1)
        }).catch((e) => {
            if(alive) setError(e?.message ?? 'failed')
        })

        return () => alive = false
    }, [index])

    if(error) return <div>{error || "couldnt access data" }</div>
    if(!item) return <PostLoading />
    
    
    if(!item || index == null){
        throw(JSON.stringify({
            status: 500,
            message: 'probably server error'
        }))
    }


    const homepage = i => {
        return item[i].hompage 
            ? [`${item[i].hompage}`, "homepage"]
            : ["#", "no homepage"]
    } 

    return (
        <>
            <article className={`bg-white w-[16rem] h-[12rem] rounded-md active:scale-105 transition-all duration-300 relative select-none z-0`}>
                <Image src={`https://raw.githubusercontent.com/yarvis405/${item[index].name}/master/thumbnail.webp`} fill={true} alt="any" quality={70} draggable={false} />

                <div className="bg-[#151515cc] p-2 h-full flex flex-col justify-between rounded-md opacity-5 active:opacity-100 hover:opacity-100 transition duration-300" focusable>
                    <div className="flex flex-col gap-2 p-2">
                        <h3 className="text-2xl text-white">{item[index].name}</h3>
                    
                        <p className="line-clamp-3">{item[index].description}</p>
                    </div>

                    <nav className="flex nowrap gap-2 justify-start">
                        <a href={homepage(index)[0]} target="_blank" ><input type="button" value={homepage(index)[1]} className={followStyle} /></a>
                        <a href={item[index].html_url} target="_blank" ><input type="button" value="github" className={followStyle}/></a>
                    </nav>
                </div>
            </article>
        </>
    )
}

export default Post
